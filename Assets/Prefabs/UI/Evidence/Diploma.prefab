    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uBCF8 \uB300\uD559\uAD50\uC758 \uC0DD\uBA85\uACF5\uD559\uACFC \uBC15\uC0AC\uACFC\uC815\uC744\n\uC6B0\uC218\uD55C
    \uC131\uC801\uC73C\uB85C \uC774\uC218\uD558\uC600\uC74C\uC744 \uC99D\uBA85\uD569\uB2C8\uB2E4.\n\n\uC5F0\uAD6C
    \uC8FC\uC81C : \uC2E0\uACBD\uC804\uB2EC\uBB3C\uC9C8\uC758 \uC778\uACF5 \uD569\uC131\uACFC
    \uC724\uB9AC\uC801 \uACBD\uACC4\n\n\uC774\uC5D0 \uB530\uB77C \uC0DD\uBA85\uACF5\uD559
    \uBC15\uC0AC \uD559\uC704\uB97C \uC218\uC5EC\uD569\uB2C8\uB2E4.\n\n20XX\uB144
    02\uC6D4 14\uC77C"
