--- !u!114 &7231079792969489538
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3629345350171175990}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 10
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uC778\uAC04 \uBCF5\uC81C \uAE30\uC220\uC740 \uB192\uC740 \uBE44\uC6A9\uC774
    \uD544\uC694\uD558\uBA70,\n\uC0AC\uD68C\uC801 \uBD88\uD3C9\uB4F1\uC744 \uC2EC\uD654\uC2DC\uD0AC
    \uAC00\uB2A5\uC131\uC774 \uC788\uB2E4.\n\n\uACBD\uC81C\uC801 \uC5EC\uC720\uAC00
    \uC788\uB294 \uBD80\uC720\uCE35\uB9CC \uBCF5\uC81C \uAE30\uC220\uC744 \uC0AC\uC6A9\uD560
    \uC218 \uC788\uB2E4\uBA74,\n\uC774\uB4E4\uC740 \uC790\uC2E0\uB4DC\uB974\uC774
    \uC720\uC804\uC801 \uD2B9\uC131\uC744 \uAC1C\uC120\uC2DC\uD0A4\uAC70\uB098 \uD2B9\uAD8C\uC744
    \uB3C5\uC810\uD558\uAC8C \uB429\uB2C8\uB2E4.\n\uC77C\uBC18 \uC0AC\uB78C\uC740
    \uD61C\uD0DD\uC5D0\uC11C \uBC30\uC81C\uB418\uC5B4 \uC0AC\uD68C\uC801 \uACA9\uCC28\uAC00
    \uD655\uB300\uB420 \uAC83\uC785\uB2C8\uB2E4,\n\n\uB354 \uB098\uC544\uAC00, \uBCF5\uC81C
    \uAE30\uC220\uC740 \uC815\uCE58\uC801, \uAD70\uC0AC\uC801\uC73C\uB85C \uC545\uC6A9\uB420
    \uAC00\uB2A5\uC131\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\n\uBCF5\uC81C \uC778\uAC04\uC73C\uB85C
    \uAD70\uC0AC\uB825\uC744 \uAC15\uD654\uD558\uAC70\uB098, \uB178\uB3D9\uB825\uC73C\uB85C
    \uC774\uC6A9\uD55C\uB2E4\uBA74,\n\uC0C8\uB85C\uC6B4 \uD615\uD0DC\uC758 \uBD88\uD3C9\uB4F1\uACFC
    \uCC29\uCDE8\uB97C \uCD08\uB798\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n"
